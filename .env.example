# ── ClauseGuard environment ────────────────────────────────────────────────
# Copy to backend/.env and fill in. NEVER commit a real .env.
#
# Two review modes:
#   · server mode — reviews run on THIS config (provider + models + key below),
#     gated by X-API-Key and the daily budget. Set this up and it "just works".
#   · bring-your-own-key — the caller posts provider/api_key/model and pays for
#     it themselves; this config is invisible to them and their runs never
#     touch your budget. The frontend uses BYOK exclusively.

# Which inference provider to use for SERVER-mode reviews: groq | cerebras | ollama | openrouter
CLAUSEGUARD_PROVIDER=groq

# Model ids are provider-specific — set these to match the chosen provider.
#   groq:     strong=llama-3.3-70b-versatile   cheap=llama-3.1-8b-instant
#   cerebras: strong=llama-3.3-70b             cheap=llama3.1-8b
CLAUSEGUARD_MODEL_STRONG=llama-3.3-70b-versatile
CLAUSEGUARD_MODEL_CHEAP=llama-3.1-8b-instant

# Groq (free tier — get a key at https://console.groq.com, no credit card)
# Note: free tier is ~100k tokens/DAY on 70b — fine for the app, too small for
# full benchmarking. Use Cerebras for large eval runs.
GROQ_API_KEY=

# Cerebras (free tier — larger daily budget; https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# OpenRouter (alternate free hosted open models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (local offline fallback — no key)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Guardrail: findings below this confidence are flagged needs_human_review
CLAUSEGUARD_CONFIDENCE_THRESHOLD=0.55

# Observability (optional — leave blank to disable, pipeline no-ops)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# API auth (comma-separated keys accepted by the backend for SERVER-mode
# reviews). BYOK requests skip this entirely.
CLAUSEGUARD_API_KEYS=dev-local-key

# Per-client-IP request cap (fixed 60s window, in-memory) on the open GET
# endpoints and on POST /v1/reviews*. 0 disables rate limiting.
CLAUSEGUARD_RATE_LIMIT_PER_MINUTE=10

# Review job store (SQLite; file path). Jobs survive restarts; swap to the
# docker-compose Postgres when this needs multiple workers.
CLAUSEGUARD_DB_PATH=clauseguard.db

# ── Spend protection (SERVER-mode reviews only). A leaked key must not be able
#    to drain your provider quota. BYOK callers pay their own bills and are
#    exempt by construction. 0 disables each. ─────────────────────────────────
# Hard cap on input+output tokens consumed per UTC day (counted from completed
# reviews); once reached, new submissions get 429 until the next day.
CLAUSEGUARD_DAILY_TOKEN_BUDGET=0
# Reject any review whose content exceeds this many characters before it burns
# a single token. Tiny texts are also cheap to fast-fail, so this is free.
CLAUSEGUARD_MAX_REVIEW_CHARS=100000
